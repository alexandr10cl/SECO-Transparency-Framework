# Database (matches docker-compose.yml defaults)
# Note: the key is DB_USER, not USER - on Linux/Mac the shell already exports
# USER with your OS login name and it would win over this file.
SGBD=mysql+mysqlconnector
DB_USER=seco_dev
PASSW=seco_dev_123
SERVER=localhost:3307
DATABASE=tool_portal

# TLS towards the database. Leave false on Railway: app and MySQL talk over a private
# network that is already encrypted. Only turn it on for an external database.
DB_SSL_REQUIRED=false

# Flask
# production = SESSION_COOKIE_SECURE on (HTTPS-only cookies) and SECRET_KEY becomes
# mandatory: index.py refuses to start without it instead of falling back to the
# "dev-secret" that is public in this repository. Defaults to production when unset.
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# Level of app.logger. Under gunicorn the default would be WARNING, hiding the
# heatmap prefetch logs.
LOG_LEVEL=INFO

# Email (optional for local dev)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# Per-connection SMTP timeout. The e-mail is sent synchronously inside the signup
# request, so without this a stalled server holds a worker thread forever.
SMTP_TIMEOUT_S=20

# App mode: True = dev (accounts born verified, no SMTP needed)
#           False = production (email verification required)
DEV_MODE=True

# UX-Tracking external API integration (https://uxt.liis.com.br — docs at /api/docs)
# True  = call UXT for signup/login tokens, heatmaps, evaluation codes (production default)
# False = fully local: signup skips UXT, heatmaps show a "disabled" notice,
#         password reset is unavailable, evaluation codes are generated locally
# If unset, the code defaults to True (safe for production).
UXT_INTEGRATION=False

# Conta de integração da UX-Tracking.
#
# Apesar do nome, NÃO é o admin do portal: é uma conta cadastrada na UXT, e precisa ser
# SUPERVISOR (role 3) lá. É ela que cria a conta UXT de cada gestor no cadastro e a
# promove a MANAGER. O nome vem da origem: estas vars nasceram para tirar do código o
# login hardcoded que a UXT exigia nessa promoção.
#
# Serve só para provisionar. Ler dados (heatmaps, análises) é sempre com o token do
# gestor logado, porque a UXT segrega as coletas por gestor (ver services/uxt_service.py).
#
# Sem elas, o cadastro de gestor falha com UXT_INTEGRATION=True. Com a integração
# desligada, podem ficar em branco.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# AI analytical layer (Findings + Action Plan tabs in the evaluation dashboard)
# ---------------------------------------------------------------------------
# True = the dashboard analyses the evaluation with an LLM and shows the tabs.
# Off by default: it costs API calls and needs a provider key.
AI_ANALYSIS=False

# True = shows the "Regenerate" button and the model picker on those tabs, so you can
# re-run the analysis on the same evaluation with a different model. Development only.
AI_ALLOW_REGENERATE=False

# Provider selection. Read by services/ai/provider.py, the single gateway to any LLM.
# Only matters for a custom AI_MODEL outside every provider's list — the model picker
# routes each listed model to its own provider regardless of this value (see CLAUDE.md,
# "Two LLM providers, routed by model").
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash

# Left commented: without AI_MODELS, the picker is the union of both providers' models.
# Without AI_FALLBACK_MODELS, each provider uses its own default chain (none for OpenAI —
# a failed gpt-6-* call goes straight to ERROR). Uncommenting either means "only these
# models"; see CLAUDE.md before trimming the picker.
# AI_FALLBACK_MODELS=gemini-3.5-flash
# AI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gpt-6-luna,gpt-6-luna-high,gpt-6-sol

# Per-request timeout in seconds, shared by every provider. Without it a stalled call
# hangs a worker thread forever.
AI_TIMEOUT_S=180

# Gemini key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI key. Get one at https://platform.openai.com/api-keys. Needed for gpt-6-luna,
# gpt-6-luna-high and gpt-6-sol — see services/ai/providers/openai_provider.py.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Mapas de calor na análise de IA
# ---------------------------------------------------------------------------
# Os mapas de calor entram na análise como CONTEXTO VISUAL: aparecem na evidência de um
# finding, mas não contam na abrangência nem na confiança, e um finding sustentado só por
# heatmap é rejeitado em código. Só funcionam com UXT_INTEGRATION=True e com sessão de
# gestor válida — a CLI (`flask ai-analyze`) roda sempre texto-só.

# Teto de páginas enviadas, imagem incluída. 0 desativa o heatmap por completo. Custo por
# página varia por provider (ver CLAUDE.md, seção de heatmaps na análise de IA) — o real
# sai no `tokens_total` do relatório de debug depois da primeira execução. Não custa tempo
# de UX-Tracking: as páginas vêm todas numa chamada só e o corte é depois, em memória.
AI_HEATMAP_MAX_PAGES=10

# ---------------------------------------------------------------------------
# Memória dos mapas de calor no dashboard
# ---------------------------------------------------------------------------
# Nada disso muda o que é exibido — só o quanto o processo segura em RAM, que numa
# plataforma cobrada por uso vai direto na conta.

# Teto de avaliações no cache em memória (services/heatmap_cache.py). Cada entrada
# guarda uma imagem JPEG em base64 por página, então o custo real é em megabytes, não
# em número de entradas. Suba se os logs mostrarem o dashboard refazendo a chamada à
# UX-Tracking a cada navegação.
HEATMAP_CACHE_MAX=8

# Threads que o login dispara para pré-carregar os heatmaps das avaliações recentes
# (services/heatmap_prefetch.py). Cada uma pode montar um payload grande em memória.
HEATMAP_PREFETCH_WORKERS=3

# Database (matches docker-compose.yml defaults)
# Note: the key is DB_USER, not USER - on Linux/Mac the shell already exports
# USER with your OS login name and it would win over this file.
SGBD=mysql+mysqlconnector
DB_USER=seco_dev
PASSW=seco_dev_123
SERVER=localhost:3307
DATABASE=tool_portal

# Flask
SECRET_KEY=change-me-in-production

# Email (optional for local dev)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# App mode: True = dev (accounts born verified, no SMTP needed)
#           False = production (email verification required)
DEV_MODE=True

# UX-Tracking external API integration (https://uxt.liis.com.br — docs at /api/docs)
# True  = call UXT for signup/login tokens, heatmaps, evaluation codes (production default)
# False = fully local: signup skips UXT, heatmaps show a "disabled" notice,
#         password reset is unavailable, evaluation codes are generated locally
# If unset, the code defaults to True (safe for production).
UXT_INTEGRATION=False

# Conta de integração da UX-Tracking.
#
# Apesar do nome, NÃO é o admin do portal: é uma conta cadastrada na UXT, e precisa ser
# SUPERVISOR (role 3) lá. É ela que cria a conta UXT de cada gestor no cadastro e a
# promove a MANAGER. O nome vem da origem: estas vars nasceram para tirar do código o
# login hardcoded que a UXT exigia nessa promoção.
#
# Serve só para provisionar. Ler dados (heatmaps, análises) é sempre com o token do
# gestor logado, porque a UXT segrega as coletas por gestor (ver services/uxt_service.py).
#
# Sem elas, o cadastro de gestor falha com UXT_INTEGRATION=True. Com a integração
# desligada, podem ficar em branco.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# AI analytical layer (Findings + Action Plan tabs in the evaluation dashboard)
# ---------------------------------------------------------------------------
# True = the dashboard analyses the evaluation with an LLM and shows the tabs.
# Off by default: it costs API calls and needs a provider key.
AI_ANALYSIS=False

# True = shows the "Regenerate" button and the model picker on those tabs, so you can
# re-run the analysis on the same evaluation with a different model. Development only.
AI_ALLOW_REGENERATE=False

# Provider selection. Read by services/ai/provider.py, the single gateway to any LLM.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash

# Tried in order when AI_MODEL is unavailable (503/504 are common on the newer flash
# models). Note gemini-3.7-flash is deliberately NOT here: it has been answering
# DEADLINE_EXCEEDED consistently and each attempt costs the whole timeout.
#
# Keep this Gemini 3 only. The heatmaps are sent as images with a per-part
# `media_resolution`, which is a Gemini 3 feature — a 2.x model may refuse them, burning
# the whole chain before the text-only retry kicks in.
AI_FALLBACK_MODELS=gemini-3.5-flash

# Offered in the model picker (only matters with AI_ALLOW_REGENERATE=True). This list is
# also the allow-list: resolve_model() rejects anything outside it, so a crafted POST
# cannot make the backend call a model you did not offer.
AI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash

# Per-request timeout. Stage 1 took ~66s on the real study, so 180s leaves room and
# still fails in useful time. Without it a stalled call hangs a worker thread forever.
AI_TIMEOUT_S=180

# Provider key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Mapas de calor na análise de IA
# ---------------------------------------------------------------------------
# Os mapas de calor entram na análise como CONTEXTO VISUAL: aparecem na evidência de um
# finding, mas não contam na abrangência nem na confiança, e um finding sustentado só por
# heatmap é rejeitado em código. Só funcionam com UXT_INTEGRATION=True e com sessão de
# gestor válida — a CLI (`flask ai-analyze`) roda sempre texto-só.

# Teto de páginas enviadas, imagem incluída. 0 desativa o heatmap por completo. Cada
# página custa 1.120 tokens de imagem, então o padrão de 10 dá ~11k tokens por análise.
# Não custa tempo de UX-Tracking: as páginas vêm todas numa chamada só e o corte é depois.
#
# A resolução das imagens NÃO é configurável — é a constante MEDIA_RESOLUTION em
# services/ai/providers/gemini.py, fixa em MEDIA_RESOLUTION_HIGH.
AI_HEATMAP_MAX_PAGES=10

# Database (matches docker-compose.yml defaults)
# Note: the key is DB_USER, not USER - on Linux/Mac the shell already exports
# USER with your OS login name and it would win over this file.
SGBD=mysql+mysqlconnector
DB_USER=seco_dev
PASSW=seco_dev_123
SERVER=localhost:3307
DATABASE=tool_portal

# Flask
SECRET_KEY=change-me-in-production

# Email (optional for local dev)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

# App mode: True = dev (accounts born verified, no SMTP needed)
#           False = production (email verification required)
DEV_MODE=True

# UX-Tracking external API integration (https://uxt.liis.com.br — docs at /api/docs)
# True  = call UXT for signup/login tokens, heatmaps, evaluation codes (production default)
# False = fully local: signup skips UXT, heatmaps show a "disabled" notice,
#         password reset is unavailable, evaluation codes are generated locally
# If unset, the code defaults to True (safe for production).
UXT_INTEGRATION=False

# Admin credentials (for initial admin user)
ADMIN_EMAIL=admin@localhost.com
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# AI analytical layer (Findings + Action Plan tabs in the evaluation dashboard)
# ---------------------------------------------------------------------------
# True = the dashboard analyses the evaluation with an LLM and shows the tabs.
# Off by default: it costs API calls and needs a provider key.
AI_ANALYSIS=False

# True = shows the "Regenerate" button and the model picker on those tabs, so you can
# re-run the analysis on the same evaluation with a different model. Development only.
AI_ALLOW_REGENERATE=False

# Provider selection. Read by services/ai/provider.py, the single gateway to any LLM.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash

# Tried in order when AI_MODEL is unavailable (503/504 are common on the newer flash
# models). Note gemini-3.7-flash is deliberately NOT here: it has been answering
# DEADLINE_EXCEEDED consistently and each attempt costs the whole timeout.
AI_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash

# Offered in the model picker (only matters with AI_ALLOW_REGENERATE=True).
AI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash

# Per-request timeout. Stage 1 took ~66s on the real study, so 180s leaves room and
# still fails in useful time. Without it a stalled call hangs a worker thread forever.
AI_TIMEOUT_S=180

# Provider key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
